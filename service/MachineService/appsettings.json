{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Controller": {
    "StartupTimeoutMilliseconds": 5000,
    "CommandTimeoutMilliseconds": 3000,
    "MaxRestartAttempts": 3,
    "RestartBackoffMilliseconds": 250,
    "RecoveryCooldownMilliseconds": 5000
  }
}
