<Window x:Class="WorkcellOperatorConsole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Industrial Workcell Operator Console"
        Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource StatusCard}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="SmallCardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="INDUSTRIAL WORKCELL" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="OPERATOR CONTROL &amp; TELEMETRY" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="SERVICE LINK" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat='Last update: {0:HH:mm:ss}'}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="LIVE OVERVIEW">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="MACHINE STATE" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding MachineStateText}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatusCard}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="CYCLE STATE" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding CycleStateText}" Style="{StaticResource CardValue}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatusCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="SAFETY STATUS" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding SafetyText}" Style="{StaticResource CardValue}"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel><TextBlock Text="ROBOT POSITION" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding RobotPositionText}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel><TextBlock Text="ROBOT MOTION" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding RobotMotionText}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel><TextBlock Text="CONVEYOR" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding ConveyorText}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel><TextBlock Text="GRIPPER" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding GripperText}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatusCard}">
                                <StackPanel><TextBlock Text="PART SENSOR" Style="{StaticResource CardLabel}" />
                                    <TextBlock Text="{Binding SensorText}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="MACHINE CONTROLS" Style="{StaticResource SectionTitle}" />
                                    <WrapPanel>
                                        <Button Content="INITIALIZE" Command="{Binding InitializeCommand}" />
                                        <Button Content="START" Command="{Binding StartCommand}" />
                                        <Button Content="PAUSE" Command="{Binding PauseCommand}" />
                                        <Button Content="RESUME" Command="{Binding ResumeCommand}" />
                                        <Button Content="STOP" Command="{Binding StopCommand}" />
                                        <Button Content="RESET" Command="{Binding ResetCommand}" />
                                        <Button Content="CLEAR E-STOP" Command="{Binding ClearEmergencyStopCommand}" />
                                    </WrapPanel>
                                    <Button Content="EMERGENCY STOP" Command="{Binding EmergencyStopCommand}"
                                            Background="{StaticResource DangerBrush}" Foreground="White"
                                            FontSize="17" Padding="20,16" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                                <StackPanel>
                                    <TextBlock Text="PRODUCTION" Style="{StaticResource SectionTitle}" />
                                    <Button Content="PROCESS ACCEPTED PART" Command="{Binding AcceptedCycleCommand}"
                                            Background="#237548" Padding="18,15" />
                                    <Button Content="PROCESS REJECTED PART" Command="{Binding RejectedCycleCommand}"
                                            Background="#8A6824" Padding="18,15" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatusCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="PRODUCTION TOTALS" Style="{StaticResource SectionTitle}" />
                                    <UniformGrid Columns="3">
                                        <StackPanel><TextBlock Text="TOTAL" Style="{StaticResource CardLabel}" />
                                            <TextBlock Text="{Binding Status.Cycle.Total}" Style="{StaticResource SmallCardValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="ACCEPTED" Style="{StaticResource CardLabel}" />
                                            <TextBlock Text="{Binding Status.Cycle.Accepted}" Style="{StaticResource SmallCardValue}" Foreground="{StaticResource SuccessBrush}" /></StackPanel>
                                        <StackPanel><TextBlock Text="REJECTED" Style="{StaticResource CardLabel}" />
                                            <TextBlock Text="{Binding Status.Cycle.Rejected}" Style="{StaticResource SmallCardValue}" Foreground="{StaticResource WarningBrush}" /></StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatusCard}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ALARM" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding FaultText}" TextWrapping="Wrap" FontSize="16"
                                               Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PRODUCTION HISTORY">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <UniformGrid Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="TOTAL" Style="{StaticResource CardLabel}" /><TextBlock Text="{Binding Metrics.TotalCycles}" Style="{StaticResource SmallCardValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ACCEPTED" Style="{StaticResource CardLabel}" /><TextBlock Text="{Binding Metrics.AcceptedCycles}" Style="{StaticResource SmallCardValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="REJECTED" Style="{StaticResource CardLabel}" /><TextBlock Text="{Binding Metrics.RejectedCycles}" Style="{StaticResource SmallCardValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="ACCEPTANCE" Style="{StaticResource CardLabel}" /><TextBlock Text="{Binding Metrics.AcceptanceRate, StringFormat={}{0:F1}%}" Style="{StaticResource SmallCardValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="AVG CYCLE" Style="{StaticResource CardLabel}" /><TextBlock Text="{Binding Metrics.AverageCycleDurationMilliseconds, StringFormat={}{0:F0} ms}" Style="{StaticResource SmallCardValue}" /></StackPanel></Border>
                    </UniformGrid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Cycles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STARTED" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                            <DataGridTextColumn Header="COMPLETED" Binding="{Binding CompletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                            <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="110" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding FinalStatus}" Width="120" />
                            <DataGridTextColumn Header="DURATION (ms)" Binding="{Binding DurationMilliseconds}" Width="130" />
                            <DataGridTextColumn Header="FAULT" Binding="{Binding FaultCode}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="FAULT HISTORY">
                <Grid Margin="14">
                    <DataGrid ItemsSource="{Binding Faults}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                            <DataGridTextColumn Header="CODE" Binding="{Binding FaultCode}" Width="170" />
                            <DataGridTextColumn Header="MACHINE" Binding="{Binding MachineState}" Width="120" />
                            <DataGridTextColumn Header="CYCLE" Binding="{Binding CycleState}" Width="150" />
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" />
                            <DataGridTextColumn Header="CLEARED" Binding="{Binding ClearedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="MACHINE EVENTS">
                <Grid Margin="14">
                    <DataGrid ItemsSource="{Binding Events}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="180" />
                            <DataGridTextColumn Header="EVENT" Binding="{Binding EventType}" Width="180" />
                            <DataGridTextColumn Header="STATE" Binding="{Binding MachineState}" Width="130" />
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <TextBlock Text="{Binding OperatorMessage}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="REST API CLIENT • 500 ms telemetry scan" HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>

</Window>
